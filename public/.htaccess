# ==========================================================
#  EasyLogger — .htaccess (Apache 2.4)
#  In 3.1 il file si chiamava "old.htaccess" e quindi non era attivo.
# ==========================================================

Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.php

# Blocca file sensibili / di sviluppo
<FilesMatch "(^\.|\.(sql|log|md|bak|dist|sample)$|^config\.local\.php$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Cache lunga per asset statici (le URL CSS/JS includono ?v=versione)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png              "access plus 1 month"
  ExpiresByType image/x-icon           "access plus 1 month"
</IfModule>
